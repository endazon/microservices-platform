      "secret": "wiki-js-dev-secret-change-me",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://wiki.localhost:50000/*",
        "http://localhost:3300/*",
        "http://localhost:3001/*",
        "http://wiki-js:3000/*"
      ],
      "webOrigins": [
        "https://wiki.localhost:50000",
        "http://localhost:3300",
        "http://localhost:3001"
      ],
      "protocolMappers": [
        {
          "name": "wikijs-realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": [
        "profile",
        "email",
        "roles",
        "abac-attributes"
      ]
    },
    {
      "clientId": "bff",
      "name": "BFF (edge, Keycloak JWT authentication)",
      "description": "IADR-0017: 外部からの入口。エッジで OIDC/JWT 認証し下流へ伝播する。redirectUris/webOrigins/post.logout.redirect.uris は**ブラウザが開く URL**（エッジ host）。backchannel.logout.url だけは**Keycloak 自身が pod から叩くサーバ間の口**であり、素の in-cluster サービス名である（#1115）。",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "bff-dev-secret-change-me",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "https://localhost/bff/auth/callback",
        "http://localhost:3100/bff/auth/callback",
        "http://localhost:5000/bff/auth/callback"
      ],
      "webOrigins": [
        "https://localhost",
        "http://localhost:3100",
        "http://localhost:5000"
      ],
      "attributes": {
        "post.logout.redirect.uris": "https://localhost/*##http://localhost:3100/*##http://localhost:5000/*",
        "backchannel.logout.url": "http://bff-service:8080/bff/auth/backchannel-logout",
        "backchannel.logout.session.required": "true"
      },
      "defaultClientScopes": [
        "profile",
        "email",
        "roles",
        "abac-attributes"
      ]
    },
    {
      "clientId": "platform-spa",
      "name": "SPA Web (SC-01..11 frontend, public client + PKCE)",
      "description": "Issue #126 / IADR-0033: フロントエンド SPA。Authorization Code + PKCE(S256) の public client。取得した JWT を BFF へ Bearer 送信する。",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:3100/*",
        "http://localhost:8081/*",
        "https://localhost/*"
      ],
      "webOrigins": [
        "http://localhost:3100",
        "http://localhost:8081",
        "https://localhost"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3100/*##http://localhost:8081/*##https://localhost/*##https://localhost"
      },
      "defaultClientScopes": [
        "profile",
        "email",
        "roles",
        "abac-attributes"
      ]
    },
    {
      "clientId": "abac-seeder",
