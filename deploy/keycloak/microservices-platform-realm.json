{
  "realm": "microservices-platform",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      { "name": "platform-admin", "description": "FR-09: 属性辞書・ABAC ポリシー管理者（AdminOnly ポリシー）" },
      { "name": "platform-operator", "description": "FR-15, IADR-0030: 運用者。構成情報の閲覧（ConfigViewer ポリシー）のみ可。管理系操作（AdminOnly）は不可" },
      { "name": "wiki-editor", "description": "Wiki.js での編集権限（表示制御の補助。ABAC 判定は本システムが真実源）" },
      { "name": "trading-owner", "description": "Issue #283, AST FR-17/UC-06, IADR-0070: AST 設定画面（全体前提条件の閲覧/変更）の利用者。ConfigurationService の OwnerOnly/OwnerOrService と同一ソース。owner ユーザーへの付与＋OIDC ログイン実疎通は後続 live issue。" }
    ]
  },
  "groups": [
    {
      "name": "clearance",
      "subGroups": [
        { "name": "public", "attributes": { "clearance": ["public"] } },
        { "name": "internal", "attributes": { "clearance": ["internal"] } },
        { "name": "confidential", "attributes": { "clearance": ["confidential"] } },
        { "name": "restricted", "attributes": { "clearance": ["restricted"] } }
      ]
    },
    {
      "name": "department",
      "subGroups": [
        { "name": "engineering", "attributes": { "department": ["engineering"] } },
        { "name": "sales", "attributes": { "department": ["sales"] } },
        { "name": "hr", "attributes": { "department": ["hr"] } }
      ]
    }
  ],
  "clientScopes": [
    {
      "name": "profile",
      "description": "OIDC 標準 profile スコープ（realm import で clientScopes を明示すると組み込みスコープが生成されないため定義する。Issue #88 稼働 PoC で実測）",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "full name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "email",
      "description": "OIDC 標準 email スコープ（同上。Wiki.js はユーザー同定に email クレームを必須とする）",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email",
            "claim.name": "email",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "roles",
      "description": "レルムロールを realm_access.roles として発行する（KeycloakRolesClaimsTransformation が ClaimTypes.Role へ展開し、FR-09 の AdminOnly=platform-admin 判定に用いる。組み込みスコープが生成されないため定義する）",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "abac-attributes",
      "description": "ABAC 属性（clearance / department）とグループを JWT に載せる。WikiService ゲートウェイと Wiki.js 表示制御が参照する。",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "clearance",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "clearance",
            "claim.name": "clearance",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "department",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "department",
            "claim.name": "department",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "wiki-js",
      "name": "Wiki.js (FR-13/UC-07, OIDC via Keycloak)",
      "description": "ADR-0011/IADR-0020: Wiki.js の認証を Keycloak に OIDC 連携。ローカルログインは Wiki.js 側で無効化し OIDC 単一経路とする。",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "wiki-js-dev-secret-change-me",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://wiki.localhost:50000/*",
        "http://localhost:3001/*",
        "http://wiki-js:3000/*"
      ],
      "webOrigins": [
        "http://wiki.localhost:50000",
        "http://localhost:3001"
      ],
      "defaultClientScopes": [
        "profile",
        "email",
        "roles",
        "abac-attributes"
      ]
    },
    {
      "clientId": "bff",
      "name": "BFF (edge, Keycloak JWT authentication)",
      "description": "IADR-0017: 外部からの入口。エッジで OIDC/JWT 認証し下流へ伝播する。",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:5000/*"
      ],
      "webOrigins": [
        "http://localhost:5000"
      ],
      "defaultClientScopes": [
        "profile",
        "email",
        "roles",
        "abac-attributes"
      ]
    },
    {
      "clientId": "spa-web",
      "name": "SPA Web (SC-01..11 frontend, public client + PKCE)",
      "description": "Issue #126 / IADR-0033: フロントエンド SPA。Authorization Code + PKCE(S256) の public client。取得した JWT を BFF へ Bearer 送信する。",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:3100/*",
        "http://localhost:8081/*",
        "http://localhost/*"
      ],
      "webOrigins": [
        "http://localhost:3100",
        "http://localhost:8081",
        "http://localhost"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3100/*##http://localhost:8081/*##http://localhost/*"
      },
      "defaultClientScopes": [
        "profile",
        "email",
        "roles",
        "abac-attributes"
      ]
    },
    {
      "clientId": "ai-stock-trading-kb-writer",
      "name": "AST KB writer (cross-unit s2s, client_credentials)",
      "description": "AST #18/IADR-0075（AST FR-08＝KB保存, 本レルム FR-06＝文書CRUD）: ai-stock-trading が確定報告書・収集情報を DocumentService へ書き込む機密クライアント（client_credentials, service-account に platform-operator）。AST レルムのトークンは issuer 不一致で通らないため本レルムで発行。本番シークレットは config から供給し dev export 値は使わない。",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "ai-stock-trading-kb-writer-dev-secret-change-me",
      "redirectUris": [],
      "webOrigins": [],
      "defaultClientScopes": [
        "roles"
      ]
    },
    {
      "clientId": "headlamp",
      "name": "Headlamp (k8s management UI, dev-only OIDC)",
      "description": "IADR-0080/#271: dev の Headlamp（k8s 管理 UI）の Keycloak OIDC ログイン用 confidential client。id_token を API server へ委譲（token passthrough）。dev 専用・本番流用禁止・secret は環境ごとに変更。",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "headlamp-dev-secret-change-me",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:4466/*",
        "http://headlamp.localhost:50000/*"
      ],
      "webOrigins": [
        "http://localhost:4466",
        "http://headlamp.localhost:50000"
      ],
      "defaultClientScopes": [
        "profile",
        "email",
        "roles"
      ]
    },
    {
      "clientId": "grafana",
      "name": "Grafana (observability, dev-only OIDC)",
      "description": "IADR-0090/#353: dev Grafana(可観測性)の Keycloak OIDC(generic OAuth) ログイン用 confidential client。dev 専用・本番流用禁止・secret は環境ごとに変更。roles クレーム(下記 mapper)で Grafana org ロールを判定する。",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "grafana-dev-secret-change-me",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://grafana.localhost:50000/login/generic_oauth",
        "http://localhost:3000/login/generic_oauth"
      ],
      "webOrigins": [
        "http://grafana.localhost:50000",
        "http://localhost:3000"
      ],
      "protocolMappers": [
        {
          "name": "grafana-realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": [
        "profile",
        "email"
      ]
    },
    {
      "clientId": "argocd",
      "name": "ArgoCD (GitOps, dev-only OIDC)",
      "description": "IADR-0092/#353: dev ArgoCD の Keycloak OIDC ログイン用 confidential client。dex 不使用(oidc.config 直)。集約後 URL argocd.localhost:50000(#357)。dev 専用・secret は環境ごとに変更。groups クレーム(mapper)で RBAC 判定。",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "argocd-dev-secret-change-me",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://argocd.localhost:50000/auth/callback",
        "http://localhost:8083/auth/callback"
      ],
      "webOrigins": [
        "http://argocd.localhost:50000",
        "http://localhost:8083"
      ],
      "protocolMappers": [
        {
          "name": "argocd-realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": [
        "profile",
        "email"
      ]
    },
    {
      "clientId": "minio",
      "name": "MinIO Console (object storage, dev-only OIDC)",
      "description": "IADR-0093/#353: dev MinIO Console の Keycloak OIDC ログイン用 confidential client。集約後 URL minio.localhost:50000(#357)。dev 専用・secret は環境ごとに変更。policy クレーム(mapper)で MinIO ポリシーを判定(未一致は deny)。",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "minio-dev-secret-change-me",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://minio.localhost:50000/oauth_callback",
        "http://localhost:9001/oauth_callback"
      ],
      "webOrigins": [
        "http://minio.localhost:50000",
        "http://localhost:9001"
      ],
      "protocolMappers": [
        {
          "name": "minio-realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "policy",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": [
        "profile",
        "email"
      ]
    },
    {
      "clientId": "vault",
      "name": "Vault (dev secrets, dev-only OIDC)",
      "description": "IADR-0094/#353: dev Vault の Keycloak OIDC(auth/oidc) ログイン用 confidential client。集約後 URL vault.localhost:50000(#357)。dev 専用・secret は環境ごとに変更。groups クレーム(mapper)で Vault external group→policy を判定。",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "vault-dev-secret-change-me",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://vault.localhost:50000/ui/vault/auth/oidc/oidc/callback",
        "https://vault.localhost:50000/ui/vault/auth/oidc/oidc/callback",
        "http://localhost:8250/oidc/callback"
      ],
      "webOrigins": [
        "http://vault.localhost:50000",
        "https://vault.localhost:50000"
      ],
      "protocolMappers": [
        {
          "name": "vault-realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": [
        "profile",
        "email"
      ]
    }
  ],
  "users": [
    {
      "username": "poc-user",
      "email": "poc-user@example.com",
      "firstName": "PoC",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "attributes": { "clearance": ["internal"], "department": ["engineering"] },
      "groups": ["/clearance/internal", "/department/engineering"],
      "credentials": [{ "type": "password", "value": "poc-password", "temporary": false }]
    },
    {
      "username": "poc-operator",
      "email": "poc-operator@example.com",
      "firstName": "PoC",
      "lastName": "Operator",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": ["platform-operator"],
      "credentials": [{ "type": "password", "value": "poc-operator-password", "temporary": false }]
    },
    {
      "username": "developer",
      "email": "developer@example.com",
      "firstName": "Dev",
      "lastName": "Developer",
      "enabled": true,
      "emailVerified": true,
      "attributes": { "clearance": ["restricted"], "department": ["engineering"] },
      "groups": ["/clearance/restricted", "/department/engineering"],
      "realmRoles": ["platform-admin", "platform-operator", "wiki-editor", "trading-owner"],
      "credentials": [{ "type": "password", "value": "developer", "temporary": false }]
    },
    {
      "username": "service-account-ai-stock-trading-kb-writer",
      "enabled": true,
      "serviceAccountClientId": "ai-stock-trading-kb-writer",
      "realmRoles": ["platform-operator"]
    }
  ]
}
