{
  "title": "Platform Overview",
  "uid": "kp-overview",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "tags": ["microservices-platform"],
  "panels": [
    {
      "id": 1,
      "title": "HTTP Request Rate (RPS)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "sum by (service_name) (rate(http_server_duration_milliseconds_count[1m]))",
        "legendFormat": "{{service_name}}"
      }]
    },
    {
      "id": 2,
      "title": "HTTP Error Rate (%)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "sum by (service_name) (rate(http_server_duration_milliseconds_count{http_status_code=~'5..'}[1m])) / sum by (service_name) (rate(http_server_duration_milliseconds_count[1m])) * 100",
        "legendFormat": "{{service_name}}"
      }]
    },
    {
      "id": 3,
      "title": "HTTP P99 Latency (ms)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "histogram_quantile(0.99, sum by (le, service_name) (rate(http_server_duration_milliseconds_bucket[5m])))",
        "legendFormat": "p99 {{service_name}}"
      }]
    },
    {
      "id": 4,
      "title": "RAG Ask Latency P99 (ms)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_duration_milliseconds_bucket{service_name='microservices-platform.aianalysis-service', http_route='/analysis/ask'}[5m])))",
        "legendFormat": "p99 /analysis/ask"
      }]
    }
  ]
}
