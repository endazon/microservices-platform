# ─────────────────────────────────────────────
# KnowledgePlatform — 環境変数テンプレート
# 使い方: cp .env.example .env && エディタで編集
# .env は .gitignore 済み（コミット厳禁）
# ─────────────────────────────────────────────

# LLM Gateway (Anthropic Claude)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Keycloak admin credentials
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Postgres (docker-compose local)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# KP app user (create-multiple-dbs.sh で使用)
KP_DB_USER=kp
KP_DB_PASSWORD=kp

# RabbitMQ
# #1022: ブローカ本体（rabbitmq サービス）と、各サービスへ注入する RabbitMq__ConnectionString の
# 双方がこの 2 つから組まれる（compose の x-rabbit-env）。コード側に既定値は無く、未注入は起動失敗。
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
