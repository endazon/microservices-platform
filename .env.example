# ─────────────────────────────────────────────
# KnowledgePlatform — 環境変数テンプレート
# 使い方: cp .env.example .env && エディタで編集
# .env は .gitignore 済み（コミット厳禁）
# ─────────────────────────────────────────────

# LLM Gateway (Anthropic Claude)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Keycloak admin credentials
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Postgres (docker-compose local)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# KP app user (create-multiple-dbs.sh で使用)
KP_DB_USER=kp
KP_DB_PASSWORD=kp

# RabbitMQ
# #1022: ブローカ本体（rabbitmq サービス）と、各サービスへ注入する RabbitMq__ConnectionString の
# 双方がこの 2 つから組まれる（compose の x-rabbit-env）。コード側に既定値は無く、未注入は起動失敗。
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# 埋め込み（Voyage AI・ティアB）。NFR-17 / ADR-0140 決定 3 / IADR-0552 (#1960)。
# 既定は有効。opt-out を確かめていない鍵の環境は、鍵を入れないか、セルフホスト（ティアA）を有効にしたうえで止める
# （手順は docs/operations/operations.md「未認定の環境へデプロイする場合」）。
# 🔴 false にするときは SELFHOSTED_EMBEDDING_ENABLED=true も与える（ティアA が無いと LLM ゲートウェイが起動しない）。
# VOYAGE_EMBEDDING_ENABLED=true
