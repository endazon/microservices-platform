<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- NFR(セキュリティ): 推移的ピンを有効化し、脆弱な推移依存(下記 Microsoft.OpenApi)を
         中央の PackageVersion でパッチ版へ固定できるようにする(#61)。 -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- ASP.NET Core (net10.0) -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <!-- NFR(セキュリティ): Microsoft.OpenApi を直接ピンし NU1903(GHSA-v5pm-xwqc-g5wc, High) を解消(#61, #80)。
         AspNetCore.OpenApi 10.0.9 の推移依存が脆弱な 2.x を引き込むため、パッチ版 2.7.5 以上へ引き上げる。 -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.7.5" />
    <!-- OpenTelemetry -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.16.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.16.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.16.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.16.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.15.1" />
    <!-- MassTransit -->
    <PackageVersion Include="MassTransit" Version="8.4.1" />
    <PackageVersion Include="MassTransit.RabbitMQ" Version="8.4.1" />
    <!-- EF Core -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
    <!-- Relational を直接ピン: Npgsql(→10.0.4) と Design(→10.0.9) の推移依存衝突(MSB3277, #34)を解消 -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.9" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.9" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
    <!-- Vector store -->
    <PackageVersion Include="Qdrant.Client" Version="1.18.1" />
    <!-- FR-06/FR-12, ADR-0015: S3 互換オブジェクトストレージ（MinIO）クライアント -->
    <PackageVersion Include="AWSSDK.S3" Version="4.0.100.2" />
    <!-- Health checks (9.x is latest; net10 compatible via netstandard2.0) -->
    <!-- NU1510 (Issue #33/#63): Microsoft.Extensions.Diagnostics.HealthChecks は Microsoft.AspNetCore.App
         共有フレームワーク由来で、どの csproj も直接参照しないため中央バージョン定義も撤去した。 -->
    <PackageVersion Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.Redis" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.Uris" Version="9.0.0" />
    <!-- HTTP -->
    <PackageVersion Include="Refit.HttpClientFactory" Version="8.0.0" />
    <PackageVersion Include="Polly.Extensions.Http" Version="3.0.0" />
    <!-- LLM -->
    <PackageVersion Include="Anthropic.SDK" Version="4.0.0" />
    <!-- Test -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <!-- xUnit v3（ADR-0030 のテスト標準。#455 A-2 で v2 から一斉に切り替えた）。
         v3 の本体パッケージ ID は `xunit.v3` であり下の ADR-0030 ブロックが持つ。`xunit`（v2 系）の
         版定義はここから削除した —— 参照が 0 件になったためである。
         runner は v2 用（2.x）と v3 用（3.x）で別系列で、**CPM は 1 パッケージ 1 バージョン**しか
         持てない。だから段階移行が成立せず 16 プロジェクトを同時に動かした。
         `Xunit.SkippableFact` も削除した。v3 対応版が存在せず（1.5.61 も xunit.extensibility.execution
         v2 に依存する）、v3 標準の Assert.Skip / Assert.SkipUnless で置き換えられるためである。 -->
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.9" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <!-- ============================================================================
         ADR-0030 バックエンドアプリケーション層標準（Issue #455）。
         計画 06_technical/12_backend-application-stack.md の棚卸し表が正。実装側の要点は
         docs/tech/tech-requirements.md「バックエンドアプリケーション層標準」を参照。
         以下は各サービスの再実装 issue（#438〜#451）が参照するための中央定義である。
         ［2026-08-22 更新 / #455 U4］従前ここは「この時点ではまだどの .csproj からも参照されて
         いない」と書いていた。**WolverineFx と WolverineFx.RabbitMQ は参照された**（ADR-0027
         手順 3〜5 の共通ヘルパ = Platform.Shared.Infrastructure/Foundation/Extensions/
         WolverineExtensions.cs。IADR-0233）。残りは依然として未参照であり、CPM の未参照
         エントリは無害である。
         不採用ライブラリ（MediatR / AutoMapper / Mapster / MassTransit / FluentAssertions /
         Serilog 等）は scripts/check-backend-libraries.js が新規混入を止める。既存の参照は
         scripts/backend-library-baseline.json で ratchet 管理し、空になった時点で
         上の PackageVersion を削除する。
         Serilog（Serilog.AspNetCore / Serilog.Sinks.OpenTelemetry）は消化済みのため削除した
         （IADR-0216。ログの出口は builder.Logging.AddOpenTelemetry() へ移した）。
         FluentAssertions も消化済みのため削除した（#455 A-3。表明は AwesomeAssertions へ移した。
         v8 の商用ライセンス化が理由で、AwesomeAssertions は v7 系のフォークである）。
         残る ratchet 対象は MassTransit だけである（Wolverine 移行 = 別作業の射程）。
         ［2026-08-22 更新 / #455 W3］従前ここは WolverineFx.RuntimeCompilation を「**引き続き**
         未参照エントリである」と書いていた。**参照された**（ADR-0027 手順 8 の実ブローカ結合
         テストの器が Wolverine ホストを実際に起こすため。Knowledge.IntegrationTests）。
         「ホストを起こす側が足す」という原則自体は変わっていない —— 器はホストを起こす側である。
         CSharpFunctionalExtensions は依然として未参照であり、CPM の未参照エントリは無害である
         （IADR-0217 決定 4。由来と参照を足す時期は各行のコメントを参照）。
         ============================================================================ -->
    <!-- Application 層: ローカル/リモートハンドラ・Outbox（ADR-0027）・検証・マッピング・DI -->
    <PackageVersion Include="WolverineFx" Version="6.24.4" />
    <PackageVersion Include="WolverineFx.RabbitMQ" Version="6.24.4" />
    <PackageVersion Include="WolverineFx.Kafka" Version="6.24.4" />
    <!-- IADR-0217: Wolverine のコード生成は実行時コンパイルを標準とする（事前 codegen ＋
         TypeLoadMode.Static は採らない）。Wolverine 6 系はコア本体から Roslyn コンパイラを分離しており、
         本パッケージが無いと既定の TypeLoadMode.Dynamic でホストが起動しない（計画 ADR-0027 §決定 の
         2026-08-04 追記 / 12_backend-application-stack の移行チェックリスト手順 2）。
         版は上の WolverineFx 系 3 つと必ず同値に保つ。PackageReference は各サービスの再実装
         issue（#438〜#451 / #441）が移行と同時に足す。
         ［2026-08-22 追記 / #455 W3］最初の参照元は実ブローカ結合テストの器
         （Knowledge.IntegrationTests）である。サービス側の追加はこれから。 -->
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="6.24.4" />
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="Riok.Mapperly" Version="4.3.1" />
    <PackageVersion Include="Scrutor" Version="7.0.0" />
    <!-- Result 型の実装（計画 ADR-0041 決定 1。IADR-0217 決定 2・3）。
         Platform.Shared.Kernel の **内部実装としてのみ** 使う。他プロジェクトの直接参照は禁止で、
         check-backend-libraries.js の BANNED に載ったままである（IADR-0196 の SHARED_KERNEL_ALLOWED が
         共有カーネルのときだけ差し引く）。**PackageVersion は同検査の対象外**（同スクリプト冒頭が明示）
         なので、BANNED 掲載と本宣言は衝突しない。
         **［2026-08-21 / #455］Platform.Shared.Kernel は実体を持った**（Result / Error を公開）。 -->
    <PackageVersion Include="CSharpFunctionalExtensions" Version="3.7.0" />
    <!-- API 層: ドキュメント UI・バージョニング -->
    <PackageVersion Include="Scalar.AspNetCore" Version="2.16.17" />
    <PackageVersion Include="Asp.Versioning.Http" Version="10.0.1" />
    <!-- Infrastructure 層: キャッシュ（L1+L2）・レジリエンス・命名規約・gRPC・鍵保護 -->
    <PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="10.8.0" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.8.0" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageVersion Include="Grpc.AspNetCore" Version="2.83.0" />
    <PackageVersion Include="Grpc.Net.Client" Version="2.83.0" />
    <PackageVersion Include="Grpc.Tools" Version="2.83.0" />
    <PackageVersion Include="Google.Protobuf" Version="3.35.1" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection" Version="10.0.10" />
    <!-- その他 -->
    <PackageVersion Include="Humanizer" Version="3.0.10" />
    <PackageVersion Include="Ardalis.GuardClauses" Version="5.0.0" />
    <!-- テスト: xUnit v3 + AwesomeAssertions（FluentAssertions v8 商用化のため v7 互換フォーク） -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="AwesomeAssertions" Version="9.5.0" />
    <PackageVersion Include="NSubstitute" Version="6.0.0" />
    <PackageVersion Include="Respawn" Version="7.0.0" />
    <!-- ============================================================================ -->
    <!-- TestContainers -->
    <PackageVersion Include="Testcontainers" Version="4.12.0" />
    <!-- 既存の Testcontainers 一族と版を揃える（family 間で版が割れると解決衝突を起こす）。 -->
    <PackageVersion Include="Testcontainers.Redis" Version="4.12.0" />
    <PackageVersion Include="Testcontainers.Qdrant" Version="4.12.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.12.0" />
    <PackageVersion Include="Testcontainers.RabbitMq" Version="4.12.0" />
    <!-- FR-06/FR-12, ADR-0015: MinIO ラウンドトリップ統合テスト用 -->
    <PackageVersion Include="Testcontainers.Minio" Version="4.12.0" />
    <!-- NFR(セキュリティ): SSH.NET を直接ピンし GHSA-q939-rpr3-3284(High) を解消(#716, IADR-0186)。
         Testcontainers の推移依存であり、直接参照しているプロジェクトは無い。
         Testcontainers は 4.13.0 でも SSH.NET 2025.1.0 のままなので、上流の更新では直らない(実測)。
         2026.0.0 は ScpClient の面を変えるが、Testcontainers は SshClient / ForwardedPortRemote
         しか使っておらず踏まない(配布アセンブリの型参照を実測)。net10.0 資産も増える。 -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>
</Project>
