{
  "name": "@microservices-platform/frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "フロントエンド npm workspaces ルート。platform=基盤アプリホスト、knowledge=付随する可変機能ユニット。追加ユニットは submodule 配置＋合成点 1 行で組み込む（FR-14 / IADR-0056）。",
  "workspaces": [
    "*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace platform",
    "build": "npm run build --workspace platform",
    "preview": "npm run preview --workspace platform",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "npm run test:e2e --workspace platform"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@playwright/test": "^1.47.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "@vitest/coverage-v8": "^2.1.1",
    "eslint": "^9.11.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.9.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.7.0",
    "vite": "^5.4.8",
    "vitest": "^2.1.1"
  }
}
