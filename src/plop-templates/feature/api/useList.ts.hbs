import { useQuery } from '@tanstack/react-query';
import type { {{pascalCase name}}Filter } from '../types';

// TODO(起点 ID): 計画書の `SC-xx` / `UC-xx` / `FR-xx` をここへ書く
// （`.claude/rules/traceability.md`「残す箇所と書式」）。
//
// 計画 13_frontend-stack §ディレクトリ構成 の `api/` —— feature の**サーバー状態**。
//
// **サーバー状態は TanStack Query に一元化する**（ADR-0031 §基本方針。グローバルストア（Redux）は
// 持たない）。QueryClient の生成点は `@foundation/api/queryClient.ts` ただ 1 つで、ユニット側は作らない。
//
// **BFF 呼び出しは orval 生成フックを使う**（ADR-0031 §基本方針「手書きクライアント禁止」）。
// 契約が生えたら、この関数の中身は次のように生成フックの呼び出しになる:
//
//   import { useBff{{pascalCase name}}List } from '@foundation/api/generated/{{camelCase name}}/{{camelCase name}}';
//   import { okArray } from '@foundation/api/orvalSelect';
//   export const use{{pascalCase name}}List = (filter: {{pascalCase name}}Filter) =>
//     useBff{{pascalCase name}}List({ keyword: filter.keyword }, { query: { select: okArray } });
//
// 生成物の入力は `docs/api/openapi.yaml` の `/bff/` 配下のみで、`pnpm run codegen` で再生成し
// コミットする（IADR-0121 決定 3。CI が再生成差分を検査する）。**手書きの HTTP クライアント
// （fetch / axios 等）は ESLint が error にする**（IADR-0121 決定 8）。
//
// 🔴 **この区分を `.gitkeep` の空枠にしない**（計画 ADR-0065 決定 4）。**queryFn を手書きのまま
// 残さないこと** —— 契約が生えた時点で生成フックへ差し替える。

/** 一覧の取得。契約が生えるまでの仮実装（生成フックへ差し替える）。 */
export const use{{pascalCase name}}List = (filter: {{pascalCase name}}Filter) =>
  useQuery<unknown[]>({
    // キーへ絞り込み条件を含める（条件が変われば別のキャッシュ）。
    queryKey: ['{{name}}', 'list', filter.keyword],
    queryFn: () => Promise.resolve([]),
  });
