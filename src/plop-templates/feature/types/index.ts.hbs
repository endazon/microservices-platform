/** 一覧の絞り込み条件（URL の検索パラメータと 1 対 1 に対応させる）。 */
export interface {{pascalCase name}}Filter {
  /** 自由入力の検索語。空文字は「絞り込みなし」を意味する。 */
  keyword: string;
}

/** 絞り込み条件の既定値（URL に何も無いときの姿）。 */
export const EMPTY_{{constantCase name}}_FILTER: {{pascalCase name}}Filter = { keyword: '' };

/**
 * URL の検索パラメータを正規化する。
 *
 * URL は外部由来なので、**未知の値は既定へ倒す** —— 選択肢しか無い UI に「エラー状態」を
 * 持ち込まない。値域の防壁はサーバ（400）に在り、ここは丸めるだけである。
 */
export function normalize{{pascalCase name}}Filter(
  raw: Record<string, unknown>,
): {{pascalCase name}}Filter {
  return { keyword: typeof raw.keyword === 'string' ? raw.keyword : '' };
}
