<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <!-- ADR-0032 / IADR-0251 / #439: セッションの判定ロジック（戻り先の検証・CSRF の適用条件）を
         テストから直接叩く。公開 API を広げずに済ませる（リポジトリの既存慣習と同じ形）。 -->
    <InternalsVisibleTo Include="Platform.Bff.Tests" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Refit.HttpClientFactory" />
    <PackageReference Include="AspNetCore.HealthChecks.Uris" />
    <PackageReference Include="AspNetCore.HealthChecks.Redis" />
    <!-- ADR-0032 / IADR-0251 / #439: BFF セッション（Token Handler）。 -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" />
    <ProjectReference Include="..\..\Shared\Platform.Shared.Contracts\Platform.Shared.Contracts.csproj" />
    <ProjectReference Include="..\..\Shared\Platform.Shared.Infrastructure\Platform.Shared.Infrastructure.csproj" />
    <!-- FR-14, IADR-0063: BFF 合成点（例外3）。可変ユニットの BFF エンドポイントを合成点で束ねる。 -->
    <ProjectReference Include="..\..\..\..\knowledge\backend\Bff\Knowledge.Bff.Endpoints\Knowledge.Bff.Endpoints.csproj" />
    <!-- FR-14, IADR-0063, IADR-0073: AST（submodule）ユニットの BFF エンドポイント（例外3）。#286 で interim の
         platform 同居から unit-owned Bff（AiStockTrading.Bff.Endpoints）へ移行。submodule checkout 前提（IADR-0065）。 -->
    <ProjectReference Include="..\..\..\..\ai-stock-trading\backend\Bff\AiStockTrading.Bff.Endpoints\AiStockTrading.Bff.Endpoints.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- SC-22, ADR-0095 決定 3, IADR-0433 決定 3, IADR-0453 決定 9 (#1411): 画面から投入できる項目の集合（allowlist）。
         単一情報源 deploy/bootstrap/sc22-secret-items.json を**写さずにリンク**して出力ディレクトリへ置く。
         BFF はこれを読めないと起動しない（fail-closed）。コンテナでは Dockerfile が同じ相対位置へ COPY する。 -->
    <Content Include="..\..\..\..\..\deploy\bootstrap\sc22-secret-items.json"
             Link="sc22-secret-items.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
