<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- FR-16, ADR-0024: MCP の公式 C# SDK（計画 11_mcp-server-integration §前提 が指定）。
         ツールは動的ハンドラで供給し、コードへ固定しない。 -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- #34: Relational を直接ピンし MSB3277 を解消（AuthorizationService と同じ理由）。 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" />
    <ProjectReference Include="..\..\..\..\Shared\Platform.Shared.Contracts\Platform.Shared.Contracts.csproj" />
    <ProjectReference Include="..\..\..\..\Shared\Platform.Shared.Infrastructure\Platform.Shared.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- FR-16, ADR-0024: 宣言的公開構成の既定（空＝非公開）。実環境では Helm values からマウントし
         Mcp:PublicationConfigPath で指す。 -->
    <Content Update="Configuration\mcp-publication.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- NFR / IADR-0280 決定 3: 合成ルートは Infrastructure（推移的に Application / Domain）を参照する。 -->
  <ItemGroup>
    <ProjectReference Include="..\McpServer.Infrastructure\McpServer.Infrastructure.csproj" />
  </ItemGroup>
</Project>
