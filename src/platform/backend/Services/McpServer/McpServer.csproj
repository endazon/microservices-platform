<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- NFR / IADR-0282 決定 1・3: 単一プロジェクト＋VSA/DDD フォルダ構成。
       層プロジェクト（.Domain / .Application / .Infrastructure / .Contracts）は撤去し、
       Domain/ ・ Features/ ・ Infrastructure/ のフォルダで境界を表す。 -->
  <ItemGroup>
    <!-- Tests/ は独立プロジェクトなので、本プロジェクトのコンパイル対象から外す
         （入れ子のままだと二重コンパイルで CS0246 が出る。基準例 f9e60ea で実測済み）。 -->
    <Compile Remove="Tests/**" />
    <Content Remove="Tests/**" />
    <None Remove="Tests/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- FR-16, ADR-0024: MCP の公式 C# SDK（計画 11_mcp-server-integration §前提 が指定）。
         ツールは動的ハンドラで供給し、コードへ固定しない。 -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- #34: Relational を直接ピンし MSB3277 を解消（AuthorizationService と同じ理由）。 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" />
    <ProjectReference Include="..\..\Shared\Platform.Shared.Contracts\Platform.Shared.Contracts.csproj" />
    <ProjectReference Include="..\..\Shared\Platform.Shared.Infrastructure\Platform.Shared.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- FR-16, ADR-0024: 宣言的公開構成の既定（空＝非公開）。実環境では Helm values からマウントし
         Mcp:PublicationConfigPath で指す。 -->
    <Content Update="Configuration\mcp-publication.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
