<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- NFR / IADR-0282 決定 1・3: 単一プロジェクト＋VSA/DDD フォルダ構成。
       層プロジェクト（.Domain / .Application / .Infrastructure / .Contracts）は撤去し、
       Domain/ ・ Features/ ・ Infrastructure/ のフォルダで境界を表す（参照方向は
       check-unit-dependencies.js の名前空間規則が守る）。 -->
  <ItemGroup>
    <!-- Tests/ は独立プロジェクトなので、本プロジェクトのコンパイル対象から外す
         （入れ子のままだと二重コンパイルで CS0246 が出る。基準例 f9e60ea で実測済み）。 -->
    <Compile Remove="Tests/**" />
    <Content Remove="Tests/**" />
    <None Remove="Tests/**" />
  </ItemGroup>
  <ItemGroup>
    <!-- NFR / IADR-0371 決定 3 / IADR-0393: 生成マッパ（PlatformUserMapper）はスライスの内側であり
         internal である。単体で直に試験するために試験プロジェクトへだけ開ける
         （FeedbackService / DocumentService 等と同じ形）。 -->
    <InternalsVisibleTo Include="AuthorizationService.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- NFR, 計画 ADR-0030 §決定（マッピング = Riok.Mapperly。選定基準 4「コンパイル時生成を優先」）
         / IADR-0371 決定 3 / IADR-0393。source generator であり、生成物は obj/ 配下に出るため
         カバレッジ集計からは既に落ちている（IADR-0195 決定 1）。版は書かない（CPM）。 -->
    <PackageReference Include="Riok.Mapperly" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- #34: Relational を直接ピンし MSB3277 (Npgsql 10.0.4 vs Design 10.0.9) を解消 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" />
    <ProjectReference Include="..\..\Shared\Platform.Shared.Contracts\Platform.Shared.Contracts.csproj" />
    <ProjectReference Include="..\..\Shared\Platform.Shared.Infrastructure\Platform.Shared.Infrastructure.csproj" />
  </ItemGroup>
</Project>
