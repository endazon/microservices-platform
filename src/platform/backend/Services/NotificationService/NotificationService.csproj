<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- NFR / IADR-0282 決定 1・3: 単一プロジェクト＋VSA/DDD フォルダ構成。
       層プロジェクト（.Domain / .Application / .Infrastructure / .Contracts）は撤去し、
       Domain/ ・ Features/ ・ Infrastructure/ ・ Common/ のフォルダで境界を表す。 -->
  <ItemGroup>
    <!-- Tests/ は独立プロジェクトなので、本プロジェクトのコンパイル対象から外す
         （入れ子のままだと二重コンパイルで CS0246 が出る。基準例 f9e60ea で実測済み）。 -->
    <Compile Remove="Tests/**" />
    <Content Remove="Tests/**" />
    <None Remove="Tests/**" />
  </ItemGroup>
  <ItemGroup>
    <!-- NFR / IADR-0371 決定 3 / IADR-0393: 生成マッパ（NotificationMapper）はスライスの内側であり
         internal である。単体で直に試験するために試験プロジェクトへだけ開ける
         （FeedbackService / DocumentService 等と同じ形）。 -->
    <InternalsVisibleTo Include="NotificationService.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- NFR, 計画 ADR-0030 §決定（検証 = FluentValidation）/ IADR-0371 決定 1・2 / IADR-0395 /
         [[IADR-0398]] 決定 7。受け口の入力検証は Features/ 側（Application 相当）で
         AbstractValidator に写す。**Domain/ には入れない**（`check-backend-libraries.js` の
         Domain 外部依存ゼロ規則）—— 検証器は Features/Notifications/Accept/ に置く。
         版は書かない（CPM。src/Directory.Packages.props が単一情報源）。 -->
    <PackageReference Include="FluentValidation" />
    <!-- NFR, 計画 ADR-0030 §決定（マッピング = Riok.Mapperly。選定基準 4「コンパイル時生成を優先」）
         / IADR-0371 決定 3 / IADR-0393。source generator であり、生成物は obj/ 配下に出るため
         カバレッジ集計からは既に落ちている（IADR-0195 決定 1）。版は書かない（CPM）。 -->
    <PackageReference Include="Riok.Mapperly" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- #34: Relational を直接ピンし MSB3277 (Npgsql vs Design) を解消 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" />
    <!-- NFR-09 / NFR-16, ADR-0029 / ADR-0075, IADR-0379 / [[IADR-0419]] (#1255): east-west gRPC の受け側。
         ホストを起こす側が受け側パッケージを持つ（共通ヘルパ経由の推移参照に頼らない。
         AuthorizationService / LlmGateway / DocumentService と同じ作法）。版は書かない（CPM）。 -->
    <PackageReference Include="Grpc.AspNetCore" />
    <ProjectReference Include="..\..\Shared\Platform.Shared.Contracts\Platform.Shared.Contracts.csproj" />
    <ProjectReference Include="..\..\Shared\Platform.Shared.Infrastructure\Platform.Shared.Infrastructure.csproj" />
  </ItemGroup>
</Project>
