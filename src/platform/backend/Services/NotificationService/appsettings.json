{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Notification": {
    "DailyEmailLimit": 500,
    "RetentionDays": 90,
    "DefaultListLimit": 50,
    "MaxListLimit": 100,
    "MaintenanceEnabled": true,
    "MaintenanceInterval": "00:05:00"
  }
}
