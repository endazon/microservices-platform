<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- NFR / IADR-0282 決定 1・3: 単一プロジェクト＋VSA/DDD フォルダ構成。
       層プロジェクト（.Domain / .Application / .Infrastructure / .Contracts）は撤去し、
       Domain/ ・ Features/ ・ Infrastructure/ ・ Common/ のフォルダで境界を表す。 -->
  <ItemGroup>
    <!-- Tests/ は独立プロジェクトなので、本プロジェクトのコンパイル対象から外す
         （入れ子のままだと二重コンパイルで CS0246 が出る。基準例 f9e60ea で実測済み）。 -->
    <Compile Remove="Tests/**" />
    <Content Remove="Tests/**" />
    <None Remove="Tests/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Anthropic.SDK" />
    <ProjectReference Include="..\..\Shared\Platform.Shared.Contracts\Platform.Shared.Contracts.csproj" />
    <ProjectReference Include="..\..\Shared\Platform.Shared.Infrastructure\Platform.Shared.Infrastructure.csproj" />
    <!-- IADR-0109 (#394): finish_reason の写像（OpenAiFinishReasons）はトランスポート内部の実装詳細であり
         公開 API にしない。写像表そのものをテストで固定するため、テストアセンブリにのみ内部を可視化する。 -->
    <InternalsVisibleTo Include="LlmGateway.Tests" />
  </ItemGroup>
</Project>
