<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><IsPackable>false</IsPackable></PropertyGroup>
  <!-- NFR / #455: Tests は 1 プロジェクト（計画 ADR-0030。Unit / Integration はフォルダで分ける）。
       xUnit は **v2** を使う。CPM の xunit.runner.visualstudio は 2.8.2（v2 用）に固定されており、
       v3 には 3.x が要る。CPM は 1 パッケージ 1 バージョンしか持てないため、v3 への切替は
       全テストプロジェクトを同時に動かす独立の作業になる。それまで xunit.v3 を参照しない。
       表明は AwesomeAssertions（FluentAssertions は商用化のため不採用。#455 A-3 で残件 0 になり
       baseline からも CPM からも消えたが、BANNED 一覧には残るので再混入は CI が fail させる）。 -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <ProjectReference Include="..\Platform.Shared.Kernel\Platform.Shared.Kernel.csproj" />
  </ItemGroup>
</Project>
