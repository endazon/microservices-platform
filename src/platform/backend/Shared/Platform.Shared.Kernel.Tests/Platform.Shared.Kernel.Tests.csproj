<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><IsPackable>false</IsPackable></PropertyGroup>
  <!-- NFR / #455: Tests は 1 プロジェクト（計画 ADR-0030。Unit / Integration はフォルダで分ける）。
       xUnit は **v3** を使う（本体は xunit.v3。CPM の xunit.runner.visualstudio は 3.1.5）。
       ［2026-08-21 更新 / #455 A-2］従前ここは「v2 を使う」だった。CPM は 1 パッケージ
       1 バージョンしか持てず段階移行が成立しないため、16 プロジェクトを一斉に切り替えた。
       表明は AwesomeAssertions（FluentAssertions は商用化のため不採用。#455 A-3 で残件 0 になり
       baseline からも CPM からも消えたが、BANNED 一覧には残るので再混入は CI が fail させる）。 -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <ProjectReference Include="..\Platform.Shared.Kernel\Platform.Shared.Kernel.csproj" />
  </ItemGroup>
</Project>
