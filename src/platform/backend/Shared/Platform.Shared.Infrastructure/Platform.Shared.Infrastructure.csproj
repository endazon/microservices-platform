<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <!-- FR-15, ADR-0018: 構成情報 API・イントロスペクションの契約 DTO（ServiceIntrospectionDto ほか）を参照する。 -->
    <ProjectReference Include="..\Platform.Shared.Contracts\Platform.Shared.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- NFR / #901: 試験専用のシーム。OTLP の送信先は AddOtlpExporter の中に閉じ、外から観測できない
         （名前総当り・IConfigureOptions の登録数 0・リフレクション走査の 3 経路で実測）。
         導出（ObservabilityExtensions.OtlpEndpointOf）だけでも試験できるよう internal を開ける。 -->
    <InternalsVisibleTo Include="Platform.Shared.Infrastructure.Tests" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <!-- ADR-0003（Superseded by ADR-0027・注記は #580）: 全サービス共通の MassTransit リトライ設定（MassTransitExtensions）を提供する。
         RabbitMQ 依存は各サービス側（*.Worker/*.Api）が持つため、ここはブローカ非依存の core のみ参照する。 -->
    <PackageReference Include="MassTransit" />
    <!-- ADR-0027 移行チェックリスト 手順 3・4・5: Wolverine の共通ヘルパ（WolverineExtensions）を提供する。
         🔴 MassTransit 側と違い **ブローカ固有の RabbitMQ パッケージも参照する**。手順 3（リスニング
         キュー名の前置）は ListenToRabbitQueue というブローカ固有 API の上でしか適用できず、
         手順 6 が「個別サービスでの逸脱を静的検査で禁止する」と定める以上、適用点そのものを
         共通ヘルパへ入れないと封じ込めが成立しないためである（IADR-0233 決定 1）。
         手順 2 の WolverineFx.RuntimeCompilation はホストを起こす各サービスの射程であり、ここには入れない。 -->
    <PackageReference Include="WolverineFx" />
    <PackageReference Include="WolverineFx.RabbitMQ" />
    <!-- FR-06/FR-12, ADR-0015: S3 互換オブジェクトストレージ（MinIO）クライアント（Storage/*） -->
    <PackageReference Include="AWSSDK.S3" />
    <!-- NFR-09 / NFR-16, ADR-0029 / ADR-0075, IADR-0379 (#1201): east-west gRPC の共通部品（Foundation/Grpc）。
         Grpc.AspNetCore = 受け側（AddGrpc / MapGrpcService と h2c リスナ）、Grpc.Net.Client = 呼び出し側
         （h2c チャネルに s2s トークンの CallCredentials を付ける）。どちらも CPM に版が既に在る
         （ADR-0030 の採用ライブラリ。新しいライブラリは足していない）。 -->
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Grpc.Net.Client" />
    <!-- NU1510 (Issue #33): Microsoft.Extensions.Diagnostics.HealthChecks は
         Microsoft.AspNetCore.App 共有フレームワークが提供するため明示参照は不要 -->
  </ItemGroup>
</Project>
