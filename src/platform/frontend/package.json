{
  "name": "@platform/frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SPA 基盤（アプリホスト + foundation: config/auth/api/routing/ui）。可変機能ユニットの features を src/features/index.ts（合成点）で束ねる。IADR-0121（IADR-0033 を Superseded）/ IADR-0056。",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
