{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom"],
    "baseUrl": ".",
    "paths": {
      "@foundation/config/*": ["../../platform/frontend/src/config/*"],
      "@foundation/config": ["../../platform/frontend/src/config"],
      "@foundation/i18n/*": ["../../platform/frontend/src/lib/i18n/*"],
      "@foundation/i18n": ["../../platform/frontend/src/lib/i18n"],
      "@foundation/routing/*": ["../../platform/frontend/src/app/routing/*"],
      "@foundation/routing": ["../../platform/frontend/src/app/routing"],
      "@foundation/api/*": ["../../platform/frontend/src/lib/api/*"],
      "@foundation/api": ["../../platform/frontend/src/lib/api"],
      "@foundation/auth/*": ["../../platform/frontend/src/lib/auth/*"],
      "@foundation/auth": ["../../platform/frontend/src/lib/auth"],
      "@foundation/utils/*": ["../../platform/frontend/src/utils/*"],
      "@foundation/utils": ["../../platform/frontend/src/utils"],
      "@foundation/ui/*": ["../../platform/frontend/src/components/ui/*"],
      "@foundation/ui": ["../../platform/frontend/src/components/ui"],
      "@foundation/notifications/*": ["../../platform/frontend/src/components/notifications/*"],
      "@foundation/notifications": ["../../platform/frontend/src/components/notifications"],
      "@foundation/ai-chat/*": ["../../platform/frontend/src/components/ai-chat/*"],
      "@foundation/ai-chat": ["../../platform/frontend/src/components/ai-chat"],
      "@foundation/testing/*": ["../../platform/frontend/src/testing/*"],
      "@foundation/testing": ["../../platform/frontend/src/testing"],
      "@features/*": ["../../platform/frontend/src/features/*"],
      "@knowledge/*": ["src/*"]
    }
  },
  "include": ["src"]
}
