<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><IsPackable>false</IsPackable></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <!-- NFR / Issue #453: カバレッジ床（scripts/check-coverage-floor.js）が集計する Cobertura を
         出力するために必須。`dotnet test --collect:"XPlat Code Coverage"` は **テストプロジェクトが
         coverlet.collector を参照していないと何も出力しない**（実測: 参照が無かったため MSP 側の
         レポートは 0 件で、CI が拾えていたのは AST submodule の 38 件だけだった）。 -->
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="MassTransit.RabbitMQ" />
    <!-- FR-15 (#142): /internal/introspection の到達性を WebApplicationFactory で検証する。 -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <!-- IADR-0043: 変換ジョブ EF ストアを InMemory provider で単体・結合検証する。 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <ProjectReference Include="..\..\src\ConversionService.Worker\ConversionService.Worker.csproj" />
  </ItemGroup>
</Project>
