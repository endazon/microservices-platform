<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- ADR-0027 §決定 必須設定 1 / #1016: 本プロジェクトは Wolverine ホストを起こす（graph-delete 段）。
         WolverineFx 本体は Platform.Shared.Infrastructure 経由で届くが、RuntimeCompilation は
         **ホストを起こす各プロジェクトが足す**（Directory.Packages.props の定め）。
         🔴 これが無いと既定の TypeLoadMode.Dynamic で **ホストが起動しない**（E1 実測）。 -->
    <PackageReference Include="WolverineFx.RuntimeCompilation" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- #34: Relational を直接ピンし MSB3277 (Npgsql 10.0.4 vs Design 10.0.9) を解消 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" />
    <ProjectReference Include="..\..\..\..\Shared\Knowledge.Contracts\Knowledge.Contracts.csproj" />
    <ProjectReference Include="..\..\..\..\..\..\platform\backend\Shared\Platform.Shared.Contracts\Platform.Shared.Contracts.csproj" />
    <ProjectReference Include="..\..\..\..\..\..\platform\backend\Shared\Platform.Shared.Infrastructure\Platform.Shared.Infrastructure.csproj" />
    <!-- IADR-0242: 型ゲート（UnfilteredSubgraph / Seal）は internal である。
         その「回避経路が無いこと」をアーキテクチャテストが検査するため、テストへ公開する。 -->
    <InternalsVisibleTo Include="GraphService.Api.Tests" />
  </ItemGroup>
  <!-- NFR / IADR-0280 決定 3: 合成ルートは Infrastructure（推移的に Application / Domain）を参照する。 -->
  <ItemGroup>
    <ProjectReference Include="..\GraphService.Infrastructure\GraphService.Infrastructure.csproj" />
  </ItemGroup>
</Project>
