<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- NFR / IADR-0282 決定 1・3: 単一プロジェクト＋VSA/DDD フォルダ構成。
       層プロジェクト（.Domain / .Application / .Infrastructure / .Contracts）は撤去し、
       Domain/ ・ Features/ ・ Infrastructure/ のフォルダで境界を表す（参照方向は
       check-unit-dependencies.js の名前空間規則が守る）。 -->
  <ItemGroup>
    <!-- Tests/ は独立プロジェクトなので、本プロジェクトのコンパイル対象から外す
         （入れ子のままだと二重コンパイルで CS0246 が出る。雛形で実測済み）。 -->
    <Compile Remove="Tests/**" />
    <Content Remove="Tests/**" />
    <None Remove="Tests/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- NFR, 計画 ADR-0030 §決定（検証 = FluentValidation）/ IADR-0371 決定 1・2 / IADR-0395。
         端点の入力検証は Features/ 側（Application 相当）で AbstractValidator に写す。
         版は書かない（CPM。src/Directory.Packages.props が単一情報源）。 -->
    <PackageReference Include="FluentValidation" />
    <!-- ADR-0027 §決定 必須設定 1 / #441 E1: 本プロジェクトは Wolverine ホストを起こす。
         WolverineFx 本体は Platform.Shared.Infrastructure 経由で届くが、RuntimeCompilation は
         **ホストを起こす各プロジェクトが足す**（Directory.Packages.props の定め）。
         🔴 これが無いと既定の TypeLoadMode.Dynamic で **ホストが起動しない**。
         ビルドは通るため、参照漏れはコンパイルでは捕まらない（実測）。
         計画は事前生成（codegen write ＋ TypeLoadMode.Static）を明示的に禁じている。 -->
    <PackageReference Include="WolverineFx.RuntimeCompilation" />

    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- #34: Relational を直接ピンし MSB3277 (Npgsql 10.0.4 vs Design 10.0.9) を解消 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <!-- EF Core Tools（dotnet ef）は startup project 側に Design を要求する。
         単一プロジェクトになったので、migrations の出力先を別プロジェクトへ向ける指定は要らない。 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" />
    <ProjectReference Include="..\..\Shared\Knowledge.Contracts\Knowledge.Contracts.csproj" />
    <ProjectReference Include="..\..\..\..\platform\backend\Shared\Platform.Shared.Contracts\Platform.Shared.Contracts.csproj" />
    <ProjectReference Include="..\..\..\..\platform\backend\Shared\Platform.Shared.Infrastructure\Platform.Shared.Infrastructure.csproj" />
    <!-- NFR, 計画 ADR-0041 決定 2 / IADR-0229 / IADR-0371 決定 4 / IADR-0395。失敗は Kernel の
         Result / Error で表し、HTTP への写像は API 層（端点）で 1 度だけ行う。**ユニット外参照として
         許可されている 3 プロジェクトの 1 つ**である（IADR-0117。check-unit-dependencies.js 規則 1）。 -->
    <ProjectReference Include="..\..\..\..\platform\backend\Shared\Platform.Shared.Kernel\Platform.Shared.Kernel.csproj" />
    <!-- IADR-0083 (#305): 単一書き手化ゲート TryRunCycleAsync 等の internal をテストへ公開する。 -->
    <InternalsVisibleTo Include="DataSourceService.Tests" />
  </ItemGroup>
</Project>
