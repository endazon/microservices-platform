<Project Sdk="Microsoft.NET.Sdk">
  <!-- NFR / IADR-0280 決定 2・4: FeedbackService の永続化実装（旧 FeedbackService.Api/
       Foundation/Persistence/ と Migrations/ の移送先。振る舞いは変えない）。
       DbContext と Migrations を同一アセンブリに置くため、EF Core の既定
       （MigrationsAssembly = DbContext のアセンブリ）どおりで明示指定は不要。
       参照方向は Application（推移的に Domain）。 -->
  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- #34: Relational を直接ピンし MSB3277 (Npgsql 10.0.4 vs Design 10.0.9) を解消 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <ProjectReference Include="..\FeedbackService.Application\FeedbackService.Application.csproj" />
  </ItemGroup>
</Project>
