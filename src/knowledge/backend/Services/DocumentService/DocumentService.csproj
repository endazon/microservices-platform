<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- NFR / IADR-0282 決定 1・3: 単一プロジェクト＋VSA/DDD フォルダ構成。
       層プロジェクト（.Domain / .Application / .Infrastructure / .Contracts）は撤去し、
       Domain/ ・ Features/ ・ Infrastructure/ のフォルダで境界を表す（参照方向は
       check-unit-dependencies.js の名前空間規則が守る）。
       Result / Error・DDD 基底型は Platform.Shared.Kernel を使う（IADR-0280 決定 6 存続）。 -->
  <ItemGroup>
    <!-- Tests/ は独立プロジェクトなので、本プロジェクトのコンパイル対象から外す
         （入れ子のままだと二重コンパイルで CS0246 が出る。FeedbackService の移送で実測済み）。 -->
    <Compile Remove="Tests/**" />
    <Content Remove="Tests/**" />
    <None Remove="Tests/**" />
  </ItemGroup>
  <ItemGroup>
    <!-- #637: 取り込み経路のタグ絞り込み（DocumentNormalizedConsumer.KnownTagsAsync）を
         ConsumeContext を組み立てずに検証するため。RetrievalService と同じ作法。 -->
    <InternalsVisibleTo Include="DocumentService.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- NFR, 計画 ADR-0030 §決定（検証 = FluentValidation）/ IADR-0371 決定 1・2 / IADR-0395 /
         [[IADR-0398]]。端点の入力検証は Features/ 側（Application 相当）で AbstractValidator に写す。
         **Domain/ には入れない**（`check-backend-libraries.js` の Domain 外部依存ゼロ規則）——
         属性規則の実体は `Domain/DocumentAttributes` の関数のままで、FluentValidation へ橋渡しする
         拡張メソッドは `Features/Documents/DocumentAttributeRules.cs` に置く。
         版は書かない（CPM。src/Directory.Packages.props が単一情報源）。 -->
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="MassTransit.RabbitMQ" />
    <!-- ADR-0027 §決定 必須設定 1 / E3a: 本プロジェクトは Wolverine ホストを起こす（DocumentDeleted 発行）。
         WolverineFx 本体は Platform.Shared.Infrastructure 経由で届くが、RuntimeCompilation は
         **ホストを起こす各プロジェクトが足す**（Directory.Packages.props の定め）。
         🔴 これが無いと既定の TypeLoadMode.Dynamic で **ホストが起動しない**（E1 実測）。 -->
    <PackageReference Include="WolverineFx.RuntimeCompilation" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- #34: Relational を直接ピンし MSB3277 (Npgsql 10.0.4 vs Design 10.0.9) を解消 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" />
    <ProjectReference Include="..\..\Shared\Knowledge.Contracts\Knowledge.Contracts.csproj" />
    <ProjectReference Include="..\..\..\..\platform\backend\Shared\Platform.Shared.Infrastructure\Platform.Shared.Infrastructure.csproj" />
  </ItemGroup>
</Project>
