<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- NFR / IADR-0282 決定 1・3: 単一プロジェクト＋VSA/DDD フォルダ構成。
       層プロジェクト（.Domain / .Application / .Infrastructure / .Contracts）は撤去し、
       Domain/ ・ Features/ ・ Infrastructure/ のフォルダで境界を表す（参照方向は
       check-unit-dependencies.js の名前空間規則が守る）。
       Result / Error・DDD 基底型は Platform.Shared.Kernel を使う（IADR-0280 決定 6 存続）。 -->
  <ItemGroup>
    <!-- Tests/ は独立プロジェクトなので、本プロジェクトのコンパイル対象から外す
         （入れ子のままだと二重コンパイルで CS0246 が出る。FeedbackService の移送で実測済み）。 -->
    <Compile Remove="Tests/**" />
    <Content Remove="Tests/**" />
    <None Remove="Tests/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- ADR-0027 §決定 必須設定 1 / #1016: 本プロジェクトは Wolverine ホストを起こす（retrieval-delete 段）。
         WolverineFx 本体は Platform.Shared.Infrastructure 経由で届くが、RuntimeCompilation は
         **ホストを起こす各プロジェクトが足す**（Directory.Packages.props の定め）。
         🔴 これが無いと既定の TypeLoadMode.Dynamic で **ホストが起動しない**（E1 実測）。 -->
    <PackageReference Include="WolverineFx.RuntimeCompilation" />
    <PackageReference Include="Qdrant.Client" />
    <PackageReference Include="AspNetCore.HealthChecks.Uris" />
    <ProjectReference Include="..\..\Shared\Knowledge.Contracts\Knowledge.Contracts.csproj" />
    <ProjectReference Include="..\..\..\..\platform\backend\Shared\Platform.Shared.Contracts\Platform.Shared.Contracts.csproj" />
    <ProjectReference Include="..\..\..\..\platform\backend\Shared\Platform.Shared.Infrastructure\Platform.Shared.Infrastructure.csproj" />
    <InternalsVisibleTo Include="RetrievalService.Tests" />
  </ItemGroup>
</Project>
