<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><IsPackable>false</IsPackable></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <!-- NFR / Issue #453: カバレッジ床（scripts/check-coverage-floor.js）が集計する Cobertura を
         出力するために必須。`dotnet test` の「XPlat Code Coverage」データコレクタは **テストプロジェクトが
         coverlet.collector を参照していないと何も出力しない**（実測: 参照が無かったため MSP 側の
         レポートは 0 件で、CI が拾えていたのは AST submodule の 38 件だけだった）。 -->
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="MassTransit.RabbitMQ" />
    <!-- FR-15 (#142): 自己申告（gRPC 面と DI の申告）を WebApplicationFactory で検証する（REST の面は #1517 で撤去）。 -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <!-- FR-02 (#1640): 埋め込みの総枠を、壁時計を待たずに進めた時計で測る。 -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <ProjectReference Include="..\IngestionService.csproj" />
  </ItemGroup>
</Project>
