<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- NFR / #580, IADR-0048 決定 1: TargetFramework / ImplicitUsings / Nullable は
         src/Directory.Build.props が単一情報源。ここで上書きしない（値が同じでも、props を
         上げたときにこの 1 件だけが取り残される）。 -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- tmpディレクトリ（残骸）をコンパイルから除外 -->
    <Compile Remove="Knowledge.IntegrationTests.tmp\**" />
    <None Remove="Knowledge.IntegrationTests.tmp\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <!-- NFR / Issue #453: カバレッジ床（scripts/check-coverage-floor.js）が集計する Cobertura を
         出力するために必須。`dotnet test` の「XPlat Code Coverage」データコレクタは **テストプロジェクトが
         coverlet.collector を参照していないと何も出力しない**（実測: 参照が無かったため MSP 側の
         レポートは 0 件で、CI が拾えていたのは AST submodule の 38 件だけだった）。 -->
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="MassTransit" />
    <PackageReference Include="Testcontainers" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.RabbitMq" />
    <!-- FR-06/FR-12, ADR-0015: MinIO ラウンドトリップ統合テスト用 -->
    <PackageReference Include="Testcontainers.Minio" />
    <PackageReference Include="AWSSDK.S3" />
  </ItemGroup>
  <ItemGroup>
    <!-- 各サービスにテスト用マーカークラスを追加したためエイリアス不要 -->
    <ProjectReference Include="..\..\Services\DocumentService\src\DocumentService.Api\DocumentService.Api.csproj" />
    <ProjectReference Include="..\..\Services\DataSourceService\src\DataSourceService.Api\DataSourceService.Api.csproj" />
    <ProjectReference Include="..\..\..\..\platform\backend\Services\AuthorizationService\src\AuthorizationService.Api\AuthorizationService.Api.csproj" />
    <ProjectReference Include="..\..\Services\WikiService\src\WikiService.Api\WikiService.Api.csproj" />
    <ProjectReference Include="..\..\Services\RetrievalService\src\RetrievalService.Api\RetrievalService.Api.csproj" />
    <ProjectReference Include="..\..\Services\AiAnalysisService\src\AiAnalysisService.Api\AiAnalysisService.Api.csproj" />
    <ProjectReference Include="..\..\..\..\platform\backend\Shared\Platform.Shared.Contracts\Platform.Shared.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
</Project>
