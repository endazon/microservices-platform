<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- NFR / #580, IADR-0048 決定 1: TargetFramework / ImplicitUsings / Nullable は
         src/Directory.Build.props が単一情報源。ここで上書きしない（値が同じでも、props を
         上げたときにこの 1 件だけが取り残される）。 -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- tmpディレクトリ（残骸）をコンパイルから除外 -->
    <Compile Remove="Knowledge.IntegrationTests.tmp\**" />
    <None Remove="Knowledge.IntegrationTests.tmp\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <!-- NFR / Issue #453: カバレッジ床（scripts/check-coverage-floor.js）が集計する Cobertura を
         出力するために必須。`dotnet test` の「XPlat Code Coverage」データコレクタは **テストプロジェクトが
         coverlet.collector を参照していないと何も出力しない**（実測: 参照が無かったため MSP 側の
         レポートは 0 件で、CI が拾えていたのは AST submodule の 38 件だけだった）。 -->
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="MassTransit" />
    <PackageReference Include="Testcontainers" />
    <!-- ADR-0027 手順 8 / #455 W3: 実ブローカ結合テストの器が Wolverine ホストを起こす。
         WolverineFx / WolverineFx.RabbitMQ は Platform.Shared.Infrastructure 経由でも届くが、
         本プロジェクトが直接使う以上は明示する。RuntimeCompilation は
         Directory.Packages.props が「ホストを起こす各プロジェクトが足す」と定めるもので、
         これが無いと既定の TypeLoadMode.Dynamic でホストが起動しない。 -->
    <PackageReference Include="WolverineFx" />
    <PackageReference Include="WolverineFx.RabbitMQ" />
    <PackageReference Include="WolverineFx.RuntimeCompilation" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.RabbitMq" />
    <!-- FR-06/FR-12, ADR-0015: MinIO ラウンドトリップ統合テスト用 -->
    <PackageReference Include="Testcontainers.Minio" />
    <PackageReference Include="AWSSDK.S3" />
  </ItemGroup>
  <ItemGroup>
    <!-- 各サービスにテスト用マーカークラスを追加したためエイリアス不要 -->
    <ProjectReference Include="..\..\Services\DocumentService\src\DocumentService.Api\DocumentService.Api.csproj" />
    <ProjectReference Include="..\..\Services\DataSourceService\DataSourceService.csproj" />
    <ProjectReference Include="..\..\..\..\platform\backend\Services\AuthorizationService\AuthorizationService.csproj" />
    <ProjectReference Include="..\..\Services\WikiService\src\WikiService.Api\WikiService.Api.csproj" />
    <!-- #455 Phase 0 U0b: Worker も統合テストへ載せる（DocumentUpdated の 2 購読者を同時に立てるため） -->
    <ProjectReference Include="..\..\Services\IngestionService\Worker\IngestionService.Worker.csproj" />
    <ProjectReference Include="..\..\Services\ConversionService\Worker\ConversionService.Worker.csproj" />
    <ProjectReference Include="..\..\Services\RetrievalService\src\RetrievalService.Api\RetrievalService.Api.csproj" />
    <ProjectReference Include="..\..\Services\AiAnalysisService\AiAnalysisService.csproj" />
    <!-- FR-17, SC-09, ADR-0033 決定 9 / #941: 辺の型辞書の **DB 層の防壁**（ON DELETE RESTRICT /
         ux_edge_types_name / ux_edges）は実 PostgreSQL でしか発火しない。GraphService.Api.Tests は
         EF InMemory であり、InMemory は一意索引も外部キーも強制しないため原理的に測れない。
         Program 型の衝突（CS0433）は GraphServiceTestMarker で避ける（IADR-0027 の作法）。 -->
    <ProjectReference Include="..\..\Services\GraphService\src\GraphService.Api\GraphService.Api.csproj" />
    <ProjectReference Include="..\..\..\..\platform\backend\Shared\Platform.Shared.Contracts\Platform.Shared.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
</Project>
