<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <!-- サービスのテストは **1 プロジェクト**にする（計画 06_technical/12_backend-application-stack
       §規範性・粒度・置き場。利用者裁定 2026-08-04 / planning#180）。フォルダは実装のスライスを
       鏡写しにする（Tests/Features/・Tests/Domain/。IADR-0282 決定 1 —— 従前の Unit/ ・ Integration/
       区分に代わる。統合テストも対象スライスのフォルダへ置く）。
       PackageReference は単体側（NSubstitute 等）と統合側（Mvc.Testing / Testcontainers /
       Respawn）の**和集合**を持つ。

       ADR-0030 のテスト標準: AwesomeAssertions（FluentAssertions v8 は商用化のため使わない）・
       NSubstitute・Testcontainers（PostgreSQL / RabbitMQ / Redis / Qdrant）・Respawn。
       xUnit は **v3**（本体パッケージ ID は xunit.v3。xunit は v2 系のまま更新されない別 ID）。
       CPM（src/Directory.Packages.props）の xunit.runner.visualstudio は v3 用である。
       **雛形はコピーしてそのまま動くことを優先する。** xunit（v2 本体）と runner 3.x の
       組み合わせは scripts/check-backend-libraries.js が CI で fail させる。
       ［2026-08-18 追記 / #830］ci.yml の template-backend-build ジョブが、本雛形を
       配置後の位置（src/<一時ユニット>/backend/）へ複製して build / test する。 -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Respawn" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SampleService.csproj" />
  </ItemGroup>
</Project>
