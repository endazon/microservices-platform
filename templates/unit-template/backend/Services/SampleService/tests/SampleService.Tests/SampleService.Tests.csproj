<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <!-- サービスのテストは **1 プロジェクト**にする。Unit / Integration はプロジェクトを分けず
       フォルダ（Unit/ ・ Integration/）で分ける（計画 06_technical/12_backend-application-stack
       §規範性・粒度・置き場。利用者裁定 2026-08-04 / planning#180）。
       プロジェクトを分けるとビルド時間と参照管理のコストが増えるためである。
       したがって PackageReference は単体側（NSubstitute 等）と統合側（Mvc.Testing / Testcontainers /
       Respawn）の**和集合**を持ち、ProjectReference は Application と Api の両方を持つ。

       ADR-0030 のテスト標準: AwesomeAssertions（FluentAssertions v8 は商用化のため使わない）・
       NSubstitute・Testcontainers（PostgreSQL / RabbitMQ / Redis / Qdrant）・Respawn。
       xUnit は **v3**（本体パッケージ ID は xunit.v3。xunit は v2 系のまま更新されない別 ID）。
       CPM（src/Directory.Packages.props）の xunit.runner.visualstudio は 3.1.5（v3 用）である。
       ［2026-08-21 更新 / #455 A-2］従前ここは「雛形は現時点で v2 を使う」だった。runner は
       v2 用（2.x）と v3 用（3.x）で別系列で、CPM は 1 パッケージ 1 バージョンしか持てないため
       段階移行が成立せず、16 のテストプロジェクトを一斉に切り替えて解消した。
       **雛形はコピーしてそのまま動くことを優先する。** 逆向きの取り残し（xunit（v2 本体）を
       参照したまま runner 3.x と組み合わさる）も scripts/check-backend-libraries.js が
       CI で fail させる（同検査は両方向を見る）。
       ［2026-08-18 追記 / #830］ci.yml の template-backend-build ジョブが、本雛形を
       配置後の位置（src/<一時ユニット>/backend/）へ複製して build / test する。 -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Respawn" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\SampleService.Application\SampleService.Application.csproj" />
    <ProjectReference Include="..\..\src\SampleService.Api\SampleService.Api.csproj" />
  </ItemGroup>
</Project>
