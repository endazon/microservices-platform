<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- テンプレート: サービスは**単一プロジェクト**（IADR-0282。オーナー裁定 2026-08-28）。
       層はプロジェクトではなく Features / Domain / Infrastructure / Common のフォルダで分け、
       参照方向は名前空間で守る（同 ADR 決定 2。Domain/ は Features/・Infrastructure/ を using しない）。
       配置後（src/<unit>/backend/Services/SampleService/）の相対パスで platform の共通基盤を参照する。
       バージョンは中央管理（CPM）に従い csproj に Version= を書かない。 -->
  <PropertyGroup>
    <!-- Tests/ はサービスディレクトリの内側に置く標準（IADR-0282 決定 1）のため、
         SDK の既定 glob から**必ず除外**する。無いと本体アセンブリがテストを二重コンパイルする（実測）。 -->
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Tests/**" />
    <Content Remove="Tests/**" />
    <None Remove="Tests/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Asp.Versioning.Http" />
    <PackageReference Include="WolverineFx" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Riok.Mapperly" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
  </ItemGroup>
  <ItemGroup>
    <!-- Result / Error・DDD 基底型は Platform.Shared.Kernel（IADR-0229 / IADR-0282 決定 1。
         サービス個別の Common/Result.cs を作らない）。 -->
    <ProjectReference Include="..\..\..\..\platform\backend\Shared\Platform.Shared.Kernel\Platform.Shared.Kernel.csproj" />
    <ProjectReference Include="..\..\..\..\platform\backend\Shared\Platform.Shared.Contracts\Platform.Shared.Contracts.csproj" />
    <ProjectReference Include="..\..\..\..\platform\backend\Shared\Platform.Shared.Infrastructure\Platform.Shared.Infrastructure.csproj" />
  </ItemGroup>
</Project>
