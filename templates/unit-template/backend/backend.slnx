<Solution>
  <!-- 追加可変機能ユニットの集約ソリューション（配置時は src/<unit>/backend/backend.slnx）。
       CI（ci.yml）は src/*/backend/backend.slnx を自動発見して restore/build/test/format する（IADR-0060）。
       プロジェクト構成は ADR-0030 の標準（Api / Application / Domain / Infrastructure / Contracts ＋ Tests）。
       詳細は docs/tech/tech-requirements.md「バックエンドアプリケーション層標準」を参照。 -->
  <Folder Name="/Services/SampleService/" />
  <Folder Name="/Services/SampleService/src/">
    <Project Path="Services/SampleService/src/SampleService.Api/SampleService.Api.csproj" />
    <Project Path="Services/SampleService/src/SampleService.Application/SampleService.Application.csproj" />
    <Project Path="Services/SampleService/src/SampleService.Domain/SampleService.Domain.csproj" />
    <Project Path="Services/SampleService/src/SampleService.Infrastructure/SampleService.Infrastructure.csproj" />
    <Project Path="Services/SampleService/src/SampleService.Contracts/SampleService.Contracts.csproj" />
  </Folder>
  <!-- テストは 1 プロジェクト。Unit / Integration はフォルダで分ける
       （計画 12_backend-application-stack §規範性・粒度・置き場 / planning#180）。 -->
  <Folder Name="/Services/SampleService/tests/">
    <Project Path="Services/SampleService/tests/SampleService.Tests/SampleService.Tests.csproj" />
  </Folder>
</Solution>
