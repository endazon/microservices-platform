<!--
  単独ビルド用フォールバック Directory.Packages.props（テンプレート同梱の実ファイル。FR-14 / IADR-0060 / IADR-0064）。

  使い方: ユニットを「単独リポジトリ」でビルドする場合のみ、拡張子 .sample を外して
          `Directory.Packages.props` としてリポジトリルートに置く（Directory.Build.props.sample と対で使う）。

  重要:
    - submodule 配置時は本体 src/Directory.Packages.props（中央管理の単一情報源）を継承するため、
      このファイルを **配置しない**（Directory.Build.props と同じ上書き問題を避ける。IADR-0060 決定4）。
    - 下は Directory.Build.props.sample と同じ import-chain（プロパティ束ね）で MSB4092 を回避する。
    - PackageVersion は単独ビルドに必要な最小限のみ。**本体 src/Directory.Packages.props の値と必ず揃える**
      （バージョン差異を作らない）。サービスが依存を増やしたら本体の値に合わせて追記する。
-->
<Project>
  <PropertyGroup>
    <ParentDirectoryPackagesProps>$([MSBuild]::GetPathOfFileAbove('Directory.Packages.props', '$(MSBuildThisFileDirectory)../'))</ParentDirectoryPackagesProps>
  </PropertyGroup>
  <Import Project="$(ParentDirectoryPackagesProps)" Condition="'$(ParentDirectoryPackagesProps)' != ''" />
  <!-- 単独時のみ効かせる中央管理の既定（本体継承時は親が定義済みのため上書きしない）。 -->
  <PropertyGroup Condition="'$(ManagePackageVersionsCentrally)' == ''">
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <!-- 雛形の 6 プロジェクトが PackageReference する全パッケージ（本体 src/Directory.Packages.props と同値）。
       CPM では PackageReference に対応する PackageVersion が無いと NU1010 で復元が失敗するため、
       1 つでも欠けると単独ビルド経路が壊れる。プロジェクトが依存を増やしたらここへも追記すること。 -->
  <ItemGroup Condition="'$(ParentDirectoryPackagesProps)' == ''">
    <!-- API 層（SampleService.Api） -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <!-- NFR(セキュリティ): AspNetCore.OpenApi 10.0.9 が引き込む脆弱な推移依存 Microsoft.OpenApi 2.0.0
         (NU1903, GHSA-v5pm-xwqc-g5wc, High) をパッチ版へ推移ピンする（本体 IADR-0016 と同値）。 -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.16.17" />
    <PackageVersion Include="Asp.Versioning.Http" Version="10.0.1" />
    <!-- Application 層（SampleService.Application / .Api のハンドラ登録） -->
    <PackageVersion Include="WolverineFx" Version="6.24.4" />
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="Riok.Mapperly" Version="4.3.1" />
    <!-- Infrastructure 層（SampleService.Infrastructure） -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
    <!-- Relational を直接ピン: Npgsql(→10.0.4) との推移依存衝突(MSB3277)を解消（本体 IADR-0003 と同値）。 -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.9" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <!-- テスト（SampleService.Tests。単体と統合を 1 プロジェクトに畳んでいるため、
         単体側〔NSubstitute〕と統合側〔Mvc.Testing / Testcontainers / Respawn〕の和集合が要る）。
         xUnit は **v2**（ADR-0030 の標準は v3 だが CPM は runner を 1 バージョンしか持てず、
         切替は独立 issue。詳細は docs/tech/tech-requirements.md）。 -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="AwesomeAssertions" Version="9.5.0" />
    <PackageVersion Include="NSubstitute" Version="6.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.9" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.12.0" />
    <PackageVersion Include="Respawn" Version="7.0.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>
</Project>
